aws_region   = "ap-south-1"
project      = "neeraj-portfolio"
environment  = "prod"
infrastructure_mode = "budget"                       # budget => Amplify only (target: < $5 at low traffic)
enable_lambda_backend = true
lambda_zip_path = "../../backend/dist/lambda.zip"
lambda_memory_size = 512
lambda_timeout = 60
allowed_origin = "*"                                  # ignored when enable_custom_domains=true
enable_custom_domains = true
root_domain = "neerajsinghi.com"
frontend_subdomain = ""                               # empty => apex domain neerajsinghi.com
frontend_enable_www = true
api_subdomain = "api"

github_repo         = "https://github.com/neerajsinghi/neeraj-portfolio"
github_org_repo     = "neerajsinghi/neeraj-portfolio"
github_access_token = "ghp_xxxxxxxxxxxxxxxxxxxx"   # GitHub PAT with repo scope

api_base_url = ""                                    # leave empty when enable_lambda_backend=true
amplify_branch = "main"
amplify_frontend_app_root = "frontend"
amplify_enable_auto_build = false                   # true if Amplify should build directly on git pushes

# Used only when infrastructure_mode = "full"
eks_node_instance_type = "t3.small"
eks_desired_nodes      = 2
eks_min_nodes          = 1
eks_max_nodes          = 4
